{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },

  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}" },

    { "name": "relwithdebinfo", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "release",        "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "debug",          "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },

    { "name": "macos-arm64",  "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "linux-arm64",  "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-x86_64", "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },

    { "name": "relwithdebinfo-macos-arm64",  "inherits": ["base", "relwithdebinfo", "macos-arm64"] },
    { "name": "release-macos-arm64",         "inherits": ["base", "release",        "macos-arm64"] },
    { "name": "debug-macos-arm64",           "inherits": ["base", "debug",          "macos-arm64"] },
    { "name": "relwithdebinfo-linux-arm64",  "inherits": ["base", "relwithdebinfo", "linux-arm64"] },
    { "name": "release-linux-arm64",         "inherits": ["base", "release",        "linux-arm64"] },
    { "name": "debug-linux-arm64",           "inherits": ["base", "debug",          "linux-arm64"] },
    { "name": "relwithdebinfo-linux-x86_64", "inherits": ["base", "relwithdebinfo", "linux-x86_64"] },
    { "name": "release-linux-x86_64",        "inherits": ["base", "release",        "linux-x86_64"] },
    { "name": "debug-linux-x86_64",          "inherits": ["base", "debug",          "linux-x86_64"] }
  ],

  "buildPresets": [
    { "name": "macos-arm64",  "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "linux-arm64",  "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-x86_64", "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },

    { "name": "relwithdebinfo-macos-arm64",  "inherits": "macos-arm64",  "configurePreset": "relwithdebinfo-macos-arm64" },
    { "name": "release-macos-arm64",         "inherits": "macos-arm64",  "configurePreset": "release-macos-arm64" },
    { "name": "debug-macos-arm64",           "inherits": "macos-arm64",  "configurePreset": "debug-macos-arm64" },
    { "name": "relwithdebinfo-linux-arm64",  "inherits": "linux-arm64",  "configurePreset": "relwithdebinfo-linux-arm64" },
    { "name": "release-linux-arm64",         "inherits": "linux-arm64",  "configurePreset": "release-linux-arm64" },
    { "name": "debug-linux-arm64",           "inherits": "linux-arm64",  "configurePreset": "debug-linux-arm64" },
    { "name": "relwithdebinfo-linux-x86_64", "inherits": "linux-x86_64", "configurePreset": "relwithdebinfo-linux-x86_64" },
    { "name": "release-linux-x86_64",        "inherits": "linux-x86_64", "configurePreset": "release-linux-x86_64" },
    { "name": "debug-linux-x86_64",          "inherits": "linux-x86_64", "configurePreset": "debug-linux-x86_64" }
  ],

  "testPresets": [
    { "name": "base", "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 120, "noTestsAction": "error" } },

    { "name": "macos-arm64",  "hidden": true, "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "linux-arm64",  "hidden": true, "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-x86_64", "hidden": true, "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },

    { "name": "relwithdebinfo-macos-arm64",  "inherits": "macos-arm64",  "configurePreset": "relwithdebinfo-macos-arm64" },
    { "name": "release-macos-arm64",         "inherits": "macos-arm64",  "configurePreset": "release-macos-arm64" },
    { "name": "debug-macos-arm64",           "inherits": "macos-arm64",  "configurePreset": "debug-macos-arm64" },
    { "name": "relwithdebinfo-linux-arm64",  "inherits": "linux-arm64",  "configurePreset": "relwithdebinfo-linux-arm64" },
    { "name": "release-linux-arm64",         "inherits": "linux-arm64",  "configurePreset": "release-linux-arm64" },
    { "name": "debug-linux-arm64",           "inherits": "linux-arm64",  "configurePreset": "debug-linux-arm64" },
    { "name": "relwithdebinfo-linux-x86_64", "inherits": "linux-x86_64", "configurePreset": "relwithdebinfo-linux-x86_64" },
    { "name": "release-linux-x86_64",        "inherits": "linux-x86_64", "configurePreset": "release-linux-x86_64" },
    { "name": "debug-linux-x86_64",          "inherits": "linux-x86_64", "configurePreset": "debug-linux-x86_64" }
  ]
}
