CompileFlags:
  # The editing host's tree, which is the Mac's. Another host names its own,
  # build/<kind>-<os>-<arch>; cmake --list-presets shows them.
  CompilationDatabase: build/relwithdebinfo-macos-arm64

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - cppcoreguidelines-pro-type-member-init
    Remove:
      - bugprone-easily-swappable-parameters
      - bugprone-narrowing-conversions

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  BlockEnd: Yes
